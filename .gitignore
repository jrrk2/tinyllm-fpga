# VC707 BFP packer / sim outputs (regenerated by the host Python pipeline)
rtl/generated/
rtl/vc707/generated
rtl/vc707/sim/generated/
rtl/vc707/sim/rtl_*.hex
rtl/vc707/sim/test_*.bin
rtl/vc707/sim/*.bin
rtl/vc707/sim/sim_int8_dut_out.txt
rtl/vc707/pyrtl_layer_*.txt

# Compiled host binary
rtl/vc707/host/bfp_client

# Verilator build dirs
rtl/vc707/sim/obj_dir*/
rtl/vc707/sim/*.bin
rtl/vc707/sim/*.vcd

# Vivado project artifacts that are regenerated by `make`
rtl/vc707/microgpt_eth.xpr
rtl/vc707/microgpt_eth.cache/
rtl/vc707/microgpt_eth.hw/
rtl/vc707/microgpt_eth.ip_user_files/
rtl/vc707/microgpt_eth.runs/
rtl/vc707/microgpt_eth.sim/
rtl/vc707/microgpt_eth.srcs/
rtl/vc707/work/
rtl/vc707/scripts/vivado*
rtl/vc707/*.log
rtl/vc707/*.jou
rtl/vc707/*.str
rtl/vc707/*.mif

# Vivado IP — only the Makefile + tcl/run.tcl are source (regenerate the
# IP from scratch).  Everything else is Vivado output: ignore by default,
# track the source by explicit name (see !patterns below).
rtl/vc707/ip/*/component.xml
rtl/vc707/ip/*/example_design/
rtl/vc707/ip/*/synth/
rtl/vc707/ip/*/sim/
rtl/vc707/ip/*/hdl/
rtl/vc707/ip/*/doc/
rtl/vc707/ip/*/*.xci
rtl/vc707/ip/*/*.xml
rtl/vc707/ip/*/*.gen/
rtl/vc707/ip/*/*.runs/
rtl/vc707/ip/*/*.cache/
rtl/vc707/ip/*/*.hw/
rtl/vc707/ip/*/*.srcs/
rtl/vc707/ip/*/*.sim/
rtl/vc707/ip/*/*.ip_user_files/
rtl/vc707/ip/*/*.xpr

# Release area: track small text artifacts (.hex / .svh / .txt / .prm /
# reports) but never the big binaries — those go to GitHub Releases.
rtl/vc707/release/*.bit
rtl/vc707/release/*.mcs
rtl/vc707/release/lbfp_full_DDR3.bin
rtl/vc707/release/bfp_vocab.bin
rtl/vc707/release/models/*/*.bin
rtl/vc707/release/bitstream/*.bit
rtl/vc707/release/bitstream/*.mcs
rtl/vc707/release/bitstream/bfp_vocab.bin

# Fine-tune outputs (HF format model dir)
generated/shakespeare-smollm/
generated/tinyshakespeare.txt

# Local Claude Code agent state — per-machine, never commit
.claude/
